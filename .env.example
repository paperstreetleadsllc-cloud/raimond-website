# RAimond Website Environment Variables

# Backend API endpoint (defaults to local backend)
VITE_RAI_ENDPOINT=http://127.0.0.1:8040

# Optional: Override individual endpoints
# VITE_SNAPSHOT_URL=http://127.0.0.1:8040/api/raiedge/snapshot
# VITE_STREAM_URL=http://127.0.0.1:8040/api/raiedge/stream

# Feature Flags
# Hero V2: Big discipline headline + HUD preview card (default: false)
# Set to "true" in Vercel Preview Environment to enable
# VITE_RAIMOND_HERO_V2=false

# AEO frontend -> API endpoint
VITE_AEO_API=http://localhost:4000

# Stripe publishable key (frontend)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx

# Stripe secret key (apps/aeo-api backend)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx

# Stripe webhook signing secret (apps/aeo-api backend)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
