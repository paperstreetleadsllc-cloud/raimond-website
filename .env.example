# --- Required in production -------------------------------------------------
# Supabase project (server-side only; never expose the service-role key).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Random string used to hash visitor IP addresses for rate limiting.
IP_HASH_SALT=

# Public site address, used for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=https://raimondai.com

# --- Accounts (Supabase Auth) -----------------------------------------------
# Public values; safe in the browser. Row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Billing (Stripe). Server only. Use TEST keys. ---------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Allowlist of subscription prices. A plan with no price shows "Opening soon".
STRIPE_PRICE_MONITOR=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_AUTHORITY=
# Leave unset. Live Stripe keys are refused until this is exactly "true".
# BILLING_LIVE_MODE_APPROVED=

# --- Local development only -------------------------------------------------
# Without Supabase variables, local runs store audits as files under .data/.
# Outbound proxy for sandboxes with no direct internet access. Never set in production.
# AUDIT_EGRESS_PROXY=
