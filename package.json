{
    "name": "raimond-website",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "engines": {
        "node": ">=20 <21"
    },
    "packageManager": "npm@10.8.2",
    "workspaces": [
        "apps/*"
    ],
    "scripts": {
        "dev": "vite",
        "dev:site": "npm run dev",
        "dev:api": "npm run dev -w apps/aeo-api",
        "dev:aeo": "npm run dev -w apps/aeo-web",
        "dev:all": "concurrently -k -n SITE,API,AEO -c green,blue,magenta \"npm run dev:site\" \"npm run dev:api\" \"npm run dev:aeo\"",
        "build": "vite build && node scripts/generate-sitemap.mjs",
        "build:aeo": "npm run build -w apps/aeo-web",
        "preview": "vite preview --port 4174",
        "lint": "eslint ./src --ext ts,tsx --max-warnings=0",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "check": "npm run lint && npm test",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@fontsource-variable/inter": "5.2.8",
        "@fontsource/space-grotesk": "5.2.10",
        "@supabase/supabase-js": "^2.84.0",
        "framer-motion": "^11.3.30",
        "lucide-react": "^0.453.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^6.26.2",
        "resend": "6.2.2"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.1.0",
        "@types/node": "^20.17.6",
        "@types/react": "^18.3.10",
        "@types/react-dom": "^18.3.5",
        "@typescript-eslint/eslint-plugin": "^8.12.1",
        "@typescript-eslint/parser": "^8.12.1",
        "@vitejs/plugin-react": "^4.7.0",
        "autoprefixer": "^10.4.20",
        "concurrently": "^9.2.1",
        "eslint": "^9.14.0",
        "eslint-plugin-react": "^7.37.2",
        "eslint-plugin-react-hooks": "^5.0.0",
        "globals": "^15.12.0",
        "jsdom": "^24.1.3",
        "postcss": "^8.4.47",
        "tailwindcss": "^3.4.13",
        "typescript": "~5.6.2",
        "vite": "^7.2.2",
        "vitest": "^4.0.10"
    }
}
