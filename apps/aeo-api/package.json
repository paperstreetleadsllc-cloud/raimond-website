{
  "name": "@raimond/aeo-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint ./src --ext ts --max-warnings=0",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "cheerio": "^1.2.0",
    "fastify": "^5.6.2",
    "fastify-raw-body": "^5.0.0",
    "node-cron": "^4.2.1",
    "p-limit": "^3.1.0",
    "stripe": "^20.3.1",
    "undici": "^7.22.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^20.19.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
